classDiagram
    class Anfitrion {
        -String numeroDocumento
        -String nombreCompleto
        -Object credenciales  %% Para login
        -int antiguedadPlataformaMeses
        -float puntuacion
        -List~Alojamiento~ alojamientosAdministrados
        +Anfitrion(String doc, String nombre, Object cred, int antig, float punt)
        +boolean iniciarSesion(String id, String pass)
        +void agregarAlojamiento(Object datosAlojamiento)
        +void eliminarAlojamiento(String codigoAlojamiento)
        +List~Reserva~ consultarReservacionesActivas(Date fechaInicio, Date fechaFin)
        +boolean anularReservacion(String codigoReservacion)
        +String obtenerInformacion()
    }

    class Huesped {
        -String numeroDocumento
        -String nombreCompleto
        -Object credenciales %% Para login
        -int antiguedadPlataformaMeses
        -float puntuacion
        -List~Reserva~ reservasRealizadas
        +Huesped(String doc, String nombre, Object cred, int antig, float punt)
        +boolean iniciarSesion(String id, String pass)
        +List~Alojamiento~ buscarAlojamientos(Object criterios)
        +Reserva reservarAlojamiento(Alojamiento alojamiento, Date fechaEnt, int numNoches, String metPago, String anot)
        +boolean anularReservacion(String codigoReservacion)
        +List~Reserva~ consultarMisReservaciones()
        +String obtenerInformacion()
    }

    class Alojamiento {
        -String codigoIdentificador
        -String nombre
        -Anfitrion anfitrionResponsable  %% Referencia directa al Anfitrion
        -String departamento
        -String municipio
        -String tipo %% e.g., "casa", "apartamento"
        -String direccion
        -float precioPorNoche
        -List~String~ amenidades
        -List~Object~ fechasReservadas %% Lista de periodos/reservas activas
        +Alojamiento(String cod, String nom, Anfitrion anfitrion, String dep, String mun, String tipo, String dir, float precio)
        +boolean estaDisponible(Date fechaInicio, int numNoches)
        +void agregarReservaInfo(Reserva reserva) %% Actualiza fechasReservadas
        +void eliminarReservaInfo(String codigoReserva)
        +String obtenerInformacionDetallada()
        +void agregarAmenidad(String amenidad)
    }

    class Reserva {
        -String codigoReserva
        -Alojamiento alojamiento %% Referencia directa al Alojamiento
        -Huesped huesped %% Referencia directa al Huesped
        -Date fechaEntrada
        -int duracionNoches
        -String metodoPago %% e.g., "PSE", "TCredito"
        -Date fechaPago
        -float montoTotal
        -String anotacionesHuesped
        +Reserva(String cod, Alojamiento aloj, Huesped hues, Date fEnt, int dur, String metPago, Date fPago, float monto, String anot)
        +Date calcularFechaSalida()
        +String generarComprobante()
        +String formatearFechaParaComprobante(Date fecha)
    }

    class SistemaUdeAStay {
        -List~Anfitrion~ listaAnfitriones
        -List~Huesped~ listaHuespedes
        -List~Alojamiento~ listaAlojamientos
        -List~Reserva~ historicoReservas %% Reservas pasadas
        +SistemaUdeAStay() %% Constructor
        +void cargarDatos()
        +void guardarDatos()
        +Object autenticarUsuario(String documento, String pass, String rol) %% Retorna Anfitrion o Huesped
        +void gestionarReservaAlojamiento(Huesped huesped, Object criteriosBusqueda, Object datosReserva)
        +void gestionarAnulacionReserva(Object usuario, String codigoReserva)
        +void consultarReservasPorAnfitrion(Anfitrion anfitrion, Date fechaInicio, Date fechaFin)
        +void actualizarHistoricoReservas(Anfitrion anfitrionSolicitante, Date fechaCorte)
        +void medirConsumoRecursos(String nombreFuncionalidad, Function operacion) %% Ejecuta y mide
        +void mostrarMenuPrincipal()
        +void mostrarMenuAnfitrion(Anfitrion anfitrion)
        +void mostrarMenuHuesped(Huesped huesped)
    }

    %% Relaciones de Asociación y Agregación
    Anfitrion "1" o-- "0..*" Alojamiento
    Alojamiento --> "1" Anfitrion

    Huesped "1" o-- "0..*" Reserva
    Reserva --> "1" Huesped

    Alojamiento "1" o-- "0..*" Reserva
    Reserva --> "1" Alojamiento

    SistemaUdeAStay o-- "*" Anfitrion
    SistemaUdeAStay o-- "*" Huesped
    SistemaUdeAStay o-- "*" Alojamiento
    SistemaUdeAStay o-- "*" Reserva